# Copy this file to .env and fill in your own values. Never commit .env.

# Leave this unset (or blank) to run in scripted DEMO_MODE — the chatbot
# will use built-in canned answers and simple regex-based fact detection,
# so you can test login + the "what we remember about you" flow before
# paying for real API calls.
#
# Set it to a real key (https://platform.openai.com/api-keys) to switch on
# real GPT-generated replies and smarter fact extraction. No code changes
# needed — the app detects this automatically at startup.
OPENAI_API_KEY=

# Any long random string. Used to sign login sessions (JWT cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Most hosts (Render, Railway, Fly.io) set
# this automatically and you can leave it as-is.
PORT=3000

# Set to "production" when deployed behind HTTPS — this makes login
# cookies "secure" (HTTPS-only). Leave unset for local development.
NODE_ENV=

# Optional. Overrides which model runs the "Rate this session" self-review
# calls (defaults to the same model as OPENAI_MODEL/gpt-4o-mini if unset).
# A stronger model here can give sharper critiques without raising the cost
# of every regular chat reply.
REVIEW_MODEL=

# Optional. Set this to enable GET /api/admin/reviews — a read-only view
# across ALL users' "Rate this session" self-reviews, for spotting patterns
# worth folding back into src/prompt.js's BASE_RULES. Pass it back as the
# x-admin-key request header. Leave unset to keep that route disabled (404).
ADMIN_KEY=

# Optional. Voice input (mic button, transcribed with Whisper) and voice
# output (the "Read replies aloud" toggle, spoken with OpenAI's TTS API)
# both reuse OPENAI_API_KEY above — no separate key needed. They're
# automatically hidden in the UI whenever OPENAI_API_KEY is unset (demo
# mode), since they can't work without a real key. Each recording and each
# spoken reply is its own paid OpenAI API call, on top of the chat/review
# calls that already happen — real added cost once turned on.
TRANSCRIBE_MODEL=
TTS_MODEL=
TTS_VOICE=

# Optional. Whisper auto-detects the spoken language when this is left
# unset, which can misfire on short/unclear clips (English speech
# mis-transcribed as another language entirely). Defaults to "en" in code
# since the rest of the app is English-only — override only if you
# localize the app to another language.
TRANSCRIBE_LANGUAGE=

# Optional. The public base URL this app is deployed at (no trailing
# slash) — needed so Google/Facebook know where to send someone back after
# they approve sign-in. Must exactly match a redirect URI registered in
# that provider's console. Defaults to http://localhost:3000 for local dev.
APP_BASE_URL=

# Optional. "Continue with Google" on the login screen. Both must be set
# together or Google sign-in stays hidden. Create these at
# https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application") with an authorized redirect URI of
# {APP_BASE_URL}/api/auth/google/callback — free, no paid account needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. "Continue with Facebook" on the login screen. Both must be set
# together or Facebook sign-in stays hidden. Create a Facebook App at
# https://developers.facebook.com/apps (add the "Facebook Login" product)
# with a valid OAuth redirect URI of
# {APP_BASE_URL}/api/auth/facebook/callback — free, but Meta's app review
# can take longer if you want it usable by the public rather than just
# accounts added as testers on the app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple ("Sign in with Apple") isn't wired up yet — it needs a paid Apple
# Developer Program membership ($99/year) and a more involved setup (a
# private-key-signed client secret rather than a plain one). See the
# README's "Social login" section before starting that one.
