# Copy this file to .env and fill in your own values. Never commit .env.

# Leave this unset (or blank) to run in scripted DEMO_MODE — the chatbot
# will use built-in canned answers and simple regex-based fact detection,
# so you can test login + the "what we remember about you" flow before
# paying for real API calls.
#
# Set it to a real key (https://platform.openai.com/api-keys) to switch on
# real GPT-generated replies and smarter fact extraction. No code changes
# needed — the app detects this automatically at startup.
OPENAI_API_KEY=

# Any long random string. Used to sign login sessions (JWT cookies).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on. Most hosts (Render, Railway, Fly.io) set
# this automatically and you can leave it as-is.
PORT=3000

# Set to "production" when deployed behind HTTPS — this makes login
# cookies "secure" (HTTPS-only). Leave unset for local development.
NODE_ENV=
